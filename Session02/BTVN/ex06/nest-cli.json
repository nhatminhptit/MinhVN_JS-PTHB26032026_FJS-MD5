{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/ex06/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/ex06/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/ex06",
  "projects": {
    "admin": {
      "type": "application",
      "root": "apps/admin",
      "entryFile": "main",
      "sourceRoot": "apps/admin/src",
      "compilerOptions": {
        "tsConfigPath": "apps/admin/tsconfig.app.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "ex06": {
      "type": "application",
      "root": "apps/ex06",
      "entryFile": "main",
      "sourceRoot": "apps/ex06/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ex06/tsconfig.app.json"
      }
    }
  }
}